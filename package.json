{
  "name": "medusa-nextjs-jsonld",
  "version": "0.1.0",
  "description": "Safe server-rendered structured data builders for Medusa v2 storefronts",
  "type": "module",
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abhi1693/medusa-nextjs-jsonld.git"
  },
  "license": "UNLICENSED",
  "typesVersions": {
    "*": {
      "react": [
        "dist/react.d.ts"
      ]
    }
  }
}
